# 基础
LISTEN=:8080

# 鉴权：对话 API 密钥（逗号分隔）；控制台密码。公网部署两项都必须设置
API_KEYS=
ADMIN_PASSWORD=

# 存储
DATA_DIR=data
BIN_DIR=.              # 热更新二进制目录（Docker 中为 /app/bin 挂载卷）

# 上游
TRAE_UPSTREAM_BASE=https://trae-api-cn.mchost.guru/api/remote/v1
TRAE_AUTH_HOST=https://api.trae.cn     # ExchangeToken / GetUserInfo
TRAE_UG_HOST=https://api.trae.cn       # 签到
TRAE_PAY_HOST=https://api.trae.cn      # 积分权益
TRAE_LOGIN_PATH=/cloudide/api/v3/trae/oauth/PasswordLogin  # 密码登录端点（实验性，可按上游变更覆盖）

# 账号池
SLOT_PER_ACCOUNT=2         # 每账号并发槽位
SLOT_QUEUE_TIMEOUT=60      # 槽位排队超时（秒）
COOLDOWN_ON_ERR=3          # 连续 N 次错误进入冷却
COOLDOWN_SECONDS=300       # 冷却时长（秒）
SCHEDULING=round-robin     # round-robin | credit（可在控制台改）

# 签到
AUTO_CHECKIN=1
CHECKIN_TIME=08:30         # 每日签到时间（北京时间）
CHECKIN_INTERVAL=60        # 多账号签到间隔（秒）
CHECKIN_BACKOFF=60         # 9074 首次退避（秒）
BACKOFF_MAX=3600           # 退避上限（秒）

# 热更新
UPDATE_REPO=               # GitHub owner/repo；留空禁用热更新
AUTO_UPDATE=0              # 自动检查并升级（控制台可改）
UPDATE_CHECK_INTERVAL=3600

# 模型列表（逗号分隔，默认 auto,glm-5.3,glm-5.2,deepseek-v4-pro,kimi-k3,doubao-seed-code）
MODELS=

# 模型绑定（可选，高级）
# TRAE_MODEL_STRATEGY=manual              # 对指定模型走 manual 绑定
# TRAE_CUSTOM_MODEL_JSON={}               # manual 时注入的 custom_model 对象
# TRAE_BIZ_USER_ID=                       # common_params 业务用户 ID

LOG_LEVEL=INFO
